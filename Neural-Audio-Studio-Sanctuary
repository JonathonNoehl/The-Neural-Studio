        "self_check_passed": self_check_passed,
        "preview_data": sample_preview,
        "full_output_track": mixed_track,
        "audible_binaural_issue": "If the humming frequency or voice layer is completely overpowering or separates distinctly, lower the mix ratio parameter below 0.1.",
        "poor_quality_issue": "If you experience clipping, popping, or low volume, verify your uploaded track file bitrate matches 44100Hz and possesses clean peak dynamics."
    }

    return integration_package

