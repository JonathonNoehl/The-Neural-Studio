import numpy as np

def verify_and_register_user(registration_payload):
    expected_fields = ["phone_number", "first_name", "last_name", "home_address", "email_address", "preferred_genre"]
    for field in expected_fields:
        if field not in registration_payload or not registration_payload[field]:
            return {"status": "error", "message": f"Missing field: {field}"}

    phone = str(registration_payload["phone_number"]).strip()
    if len(phone) != 10 or not phone.isdigit():
        return {"status": "error", "message": "Invalid 10-digit phone number"}

    user_profile = {
        "phone_number": phone,
        "first_name": registration_payload["first_name"].strip(),
        "last_name": registration_payload["last_name"].strip(),
        "home_address": registration_payload["home_address"].strip(),
        "email_address": registration_payload["email_address"].strip(),
        "preferred_genre": registration_payload["preferred_genre"].strip(),
        "token_balance": 5
    }
    return {"status": "success", "profile": user_profile}
def reward_user_from_ad(user_profile, ad_reward_tokens=2):
    """
    Rewards the user with tokens for completing an advertisement view.
    Balances out production costs during early prototype testing.
    """
    current_balance = user_profile.get("token_balance", 0)
    user_profile["token_balance"] = current_balance + ad_reward_tokens
    
    return {
        "status": "success",
        "message": f"Ad reward processed. Added {ad_reward_tokens} tokens.",
        "updated_balance": user_profile["token_balance"]
    }

def complete_transaction_and_download(user_profile, track_cost_coins=3, successful_tracks_count=1):
    """
    Manages token deduction for generating and downloading integration tracks.
    Cost is scaled to incentivize watching 1-2 ads per track generated.
    """
    current_balance = user_profile.get("token_balance", 0)
    total_cost = track_cost_coins * successful_tracks_count

    if current_balance < total_cost:
        return {
            "status": "insufficient_funds",
            "message": f"Required: {total_cost} tokens. Available: {current_balance} tokens.",
            "action_required": "Prompt user to watch an advertisement to earn tokens."
        }

    # Deduct tokens for the track generation
    new_balance = current_balance - total_cost
    user_profile["token_balance"] = new_balance

    # Pull staged asset from the infrastructure layer
    blob_storage_uri = "https://windows.net"

    return {
        "status": "success",
        "message": f"Transaction complete. Compiled {successful_tracks_count} track(s).",
        "tokens_deducted": total_cost,
        "updated_balance": new_balance,
        "download_url": blob_storage_uri
    }

def process_user_track_upload(audio_data, max_duration=180, sample_rate=44100):
    max_samples = max_duration * sample_rate
    if len(audio_data) > max_samples:
        audio_data = audio_data[:max_samples]

    max_val = np.max(np.abs(audio_data))
    if max_val > 0:
        audio_data = audio_data / max_val

    return audio_data

def get_frequency_wave_shift(wave_type="alpha"):
    wave_shifts = {
        "delta": 2.5,
        "theta": 6.0,
        "alpha": 10.5,
        "beta": 14.5,
        "gamma": 40.0
    }
    return wave_shifts.get(wave_type.lower(), 10.5)

def generate_binaural_layer(wave_type="alpha", duration_seconds=180, sample_rate=44100):
    beat_freq = get_frequency_wave_shift(wave_type)
    carrier_freq = 300.0

    left_freq = carrier_freq - (beat_freq / 2)
    right_freq = carrier_freq + (beat_freq / 2)

    t = np.linspace(0, duration_seconds, int(sample_rate * duration_seconds), endpoint=False)

    left_channel = np.sin(2 * np.pi * left_freq * t)
    right_channel = np.sin(2 * np.pi * right_freq * t)

    binaural_matrix = np.vstack((left_channel, right_channel)).T
    return binaural_matrix

