        user_stereo = np.vstack((user_track, user_track)).T
    else:
        user_stereo = user_track

    if len(subconscious_layer_data.shape) == 1:
        subconscious_stereo = np.vstack((subconscious_layer_data, subconscious_layer_data)).T
    else:
        subconscious_stereo = subconscious_layer_data

    if len(subconscious_stereo) < len(user_stereo):
        pad_len = len(user_stereo) - len(subconscious_stereo)
        subconscious_stereo = np.pad(subconscious_stereo, ((0, pad_len), (0, 0)), mode='constant')
    else:
        subconscious_stereo = subconscious_stereo[:len(user_stereo)]

    mixed_track = (user_stereo * (1.0 - mix_ratio)) + (subconscious_stereo * mix_ratio)

    max_val = np.max(np.abs(mixed_track))
    if max_val > 0:
        mixed_track = mixed_track / max_val

    self_check_passed = True
    if np.isnan(mixed_track).any() or np.isinf(mixed_track).any():
        self_check_passed = False

    sample_preview = mixed_track[:int(sample_rate * 15)]

